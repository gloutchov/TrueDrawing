        "tool": "brush",
        "size": 28,
        "opacity": 0.7,
        "hardness": 0.25,
        "spacing": 0.15,
        "pressureSize": 0.65,
        "pressureOpacity": 0.25,
        "velocitySize": 0.25,
        "texture": "none",
        "textureAmount": 0,
        "textureScale": 4
      },
      {
        "presetId": "marker",
        "label": {
          "it": "Marker",
          "en": "Marker"
        },
        "tool": "marker",
        "size": 18,
        "opacity": 0.45,
        "hardness": 0.9,
        "spacing": 0.15,
        "pressureSize": 0.65,
        "pressureOpacity": 0.25,
        "velocitySize": 0.25,
        "texture": "none",
        "textureAmount": 0,
        "textureScale": 4
      },
      {
        "presetId": "ink",
        "label": {
          "it": "Inchiostro",
          "en": "Ink"
