        "tool": "brush",
        "size": 10,
        "opacity": 1,
        "hardness": 1,
        "spacing": 0.15,
        "pressureSize": 0.65,
        "pressureOpacity": 0.25,
        "velocitySize": 0.25,
        "texture": "none",
        "textureAmount": 0,
        "textureScale": 4
      },
      {
        "presetId": "texture",
        "label": {
          "it": "Texture",
          "en": "Texture"
        },
        "tool": "brush",
        "size": 20,
        "opacity": 0.85,
        "hardness": 0.8,
        "spacing": 0.15,
        "pressureSize": 0.65,
        "pressureOpacity": 0.25,
        "velocitySize": 0.25,
        "texture": "hatch",
        "textureAmount": 0.8,
        "textureScale": 4
      }
    ]
  },
  "layers": {
    "defaultLayerName": "Layer 1",
    "newLayerNamePrefix": "Layer",
    "defaultOpacity": 1,
    "maxLayers": 32,
    "opacityRange": {
      "min": 0.05,
      "max": 1,
      "step": 0.05
    }
  },
  "imageGeneration": {
    "defaultProvider": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "defaultModel": "gpt-image-1.5",
    "availableModels": [
      "gpt-image-1.5",
      "gpt-image-1",
      "gpt-image-1-mini"
    ],
    "defaultStyle": "realistica",
    "availableStyles": [
      "acquerello",
      "cartoon",
      "infantile",
      "olio",
      "realistica",
      "surreale"
    ],
    "autoRedrawDefaultEnabled": false,
    "autoRedrawDefaultDelaySeconds": 5,
    "autoRedrawDelayRange": {
      "min": 1,
      "max": 120,
      "step": 1
    },
    "defaultSize": "1024x1024",
    "defaultQuality": "auto",
    "canvasPaddingRatio": 0.08,
    "timeoutMs": 120000,
    "defaultOutputFormat": "png",
    "maxImageBytes": 16777216,
    "maxCustomStyleLength": 80,
    "stylePresets": [
      {
        "id": "acquerello",
        "name": {
          "it": "Acquerello",
          "en": "Watercolor"
        },
        "description": {
          "it": "Pigmenti trasparenti, carta e bordi morbidi.",
          "en": "Transparent pigments, paper grain and soft edges."
        },
        "promptFragment": "Render a watercolor painting with transparent pigment washes, subtle paper grain and soft paint edges. Preserve the sketch composition.",
        "parameters": {
          "quality": "auto",
          "size": "1024x1024"
        }
      },
      {
        "id": "cartoon",
        "name": {
          "it": "Cartoon",
          "en": "Cartoon"
        },
        "description": {
          "it": "Contorni puliti e colori piatti espressivi.",
          "en": "Clean outlines and expressive flat colors."
        },
        "promptFragment": "Render a polished cartoon illustration with clean outlines, expressive shapes and controlled flat colors. Preserve the sketch composition.",
        "parameters": {
          "quality": "auto",
          "size": "1024x1024"
        }
      },
      {
        "id": "infantile",
        "name": {
          "it": "Disegno infantile",
          "en": "Childlike drawing"
        },
        "description": {
          "it": "Tratti spontanei, pastelli e forme semplici.",
          "en": "Spontaneous strokes, crayon texture and simple forms."
        },
        "promptFragment": "Render a playful childlike drawing with spontaneous lines, crayon textures and simple forms. Preserve the sketch composition.",
        "parameters": {
          "quality": "auto",
          "size": "1024x1024"
        }
      },
      {
        "id": "olio",
        "name": {
          "it": "Pittura a olio",
          "en": "Oil painting"
        },
        "description": {
          "it": "Pennellate ricche e luce pittorica.",
          "en": "Rich brushwork and painterly lighting."
        },
        "promptFragment": "Render an oil painting with rich brushwork, layered pigments and coherent painterly light. Preserve the sketch composition.",
        "parameters": {
          "quality": "auto",
          "size": "1024x1024"
        }
      },
      {
        "id": "realistica",
        "name": {
          "it": "Realistico",
          "en": "Realistic"
        },
        "description": {
          "it": "Luce naturale, materiali e dettagli plausibili.",
          "en": "Natural light, plausible materials and detailed surfaces."
        },
        "promptFragment": "Render a realistic image with natural lighting, plausible materials and detailed surfaces. Preserve the sketch composition.",
        "parameters": {
          "quality": "auto",
          "size": "1024x1024"
        }
      },
      {
        "id": "surreale",
        "name": {
          "it": "Surreale",
          "en": "Surreal"
        },
        "description": {
          "it": "Atmosfera onirica e materiali evocativi.",
          "en": "Dreamlike atmosphere and evocative materials."
        },
        "promptFragment": "Render a surreal image with a dreamlike atmosphere, evocative materials and coherent lighting. Preserve the original subjects and composition.",
        "parameters": {
          "quality": "auto",
          "size": "1024x1024"
        }
      }
    ]
  },
  "files": {
    "defaultProjectName": "Untitled Drawing",
    "autosaveDirectoryName": "autosave",
    "autosaveExtension": ".autosave.tdraw",
    "canvasSuffix": "_canvas",
    "imageSuffix": "_image",
    "projectExtension": ".tdraw",
    "canvasExportExtension": ".png",
    "imageExportExtension": ".png",
    "webpExportExtension": ".webp",
    "maxProjectBytes": 67108864
  },
  "references": {
    "maxImages": 4,
    "maxImageBytes": 4194304,
    "defaultOpacity": 0.5,
    "maxScale": 4
  },
  "snapshots": {
    "maxCount": 20,
    "maxSnapshotBytes": 8388608,
    "maxTotalBytes": 33554432,
    "maxNameLength": 80,
    "autoDefaultEnabled": false,
    "autoIntervalMs": 300000
  }
}
